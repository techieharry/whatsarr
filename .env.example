# whatsarr config — copy to `.env` and fill in your values.
# Do not commit `.env`; it's in .gitignore.

# ---- Seerr (or Overseerr / Jellyseerr) ----
# Base URL of your Seerr instance. If you bind to a private network interface
# (Tailscale / Wireguard), use that address here.
SEERR_URL=http://your-seerr-host:5055
# API key from Seerr → Settings → General.
SEERR_API_KEY=

# ---- WhatsApp ----
# Bot's WhatsApp number (a dedicated secondary/burner account — see Risks in the
# README; do not use your primary number). Documentation only — the live identity
# is stored in the auth dir after the one-time QR pair.
BOT_WHATSAPP_NUMBER=+15555550100
# Comma-separated group JIDs the bot will respond in (e.g. 120363xxxxxxxxx@g.us).
# Run `npm run discover` after pairing to dump the JIDs of every group the bot is
# a member of.
ALLOWED_GROUPS=
# Optional friendly names for the !announce target picker, comma-separated and
# positional (aligned to ALLOWED_GROUPS order). Missing entries fall back to JID.
# e.g. GROUP_LABELS=Family,Friends
GROUP_LABELS=
# Comma-separated bare numbers for admin DMs (!approve, !deny, !map, !shutdown;
# also receive !feedback / !issue reports).
ADMIN_NUMBERS=

# ---- Behavior ----
COMMAND_PREFIX=!
REQUESTS_PER_DAY=5
DEDUP_WINDOW_HOURS=1
CONFIRM_TTL_MINUTES=10
# Per-member daily cap on !prioritize (forces an immediate Sonarr/Radarr search
# so a download starts now instead of at the next RSS sync). 0 disables it.
PRIORITY_PER_DAY=1

# ---- Prioritize: direct Sonarr/Radarr (optional) ----
# !prioritize talks directly to Sonarr/Radarr. By default it auto-discovers both
# servers (URL + API key) from Seerr's own settings — no config needed. Set these
# ONLY if that auto-discovered host isn't reachable from the bot (e.g. the *arr
# runs on a different box than Seerr). Leave empty to use auto-discovery.
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=

# ---- Webhook (Seerr -> whatsarr "media ready" callback) ----
WEBHOOK_ENABLED=true
WEBHOOK_PORT=5056
# 127.0.0.1 = loopback only. 0.0.0.0 = all interfaces (set this if Seerr runs in
# Docker and reaches the bot via host.docker.internal).
WEBHOOK_BIND=127.0.0.1
# Recommended hardening: set this AND configure the same value as the webhook's
# shared secret in Seerr (Settings → Notifications → Webhook). Empty = no check.
SEERR_WEBHOOK_SECRET=
# Per-IP fixed-window (60s) rate limit on POST /webhook. 0 disables. Default 60.
WEBHOOK_RATE_LIMIT=60
# Window (ms) to coalesce repeat MEDIA_AVAILABLE events for the same media into a
# single "ready" notification (anti-spam). Default 45000.
WEBHOOK_READY_COALESCE_MS=45000

# ---- Seerr request ownership ----
SEERR_DEFAULT_USER_ID=1
# Per-user attribution is managed at runtime via the !map admin command
# (whatsapp number -> seerr user id), stored in the DB. No env var needed.

# ---- Storage ----
DB_PATH=data/whatsarr.sqlite
AUTH_DIR=auth_info_baileys

# ---- Syncthing (optional — powers !sync and the dashboard #syncthing panel) ----
# Leave URL/API key empty to disable. SYNCTHING_FOLDERS (plural, comma-separated
# folder IDs) drives the dashboard panel; if unset it falls back to the single
# SYNCTHING_FOLDER_ID used by !sync.
SYNCTHING_URL=
SYNCTHING_API_KEY=
SYNCTHING_FOLDER_ID=
SYNCTHING_FOLDERS=
SYNCTHING_REMOTE_DEVICE_ID=
SYNCTHING_REMOTE_LABEL=remote

# ---- Operator dashboard (optional) ----
# Empty = dashboard endpoints respond 503. Set a long random string, then open
# http://<host>:5056/dashboard/?token=<value>
DASHBOARD_TOKEN=

# ---- Watchlist auto-sync (optional) ----
# The poller reads Plex Watchlist and/or Letterboxd RSS feeds and auto-requests
# new items through the same routing / audit / dedup / "now ready" path as a chat
# request. Leave WATCHLIST_SOURCES empty to disable.
#   - Plex: generate a Watchlist RSS URL at https://app.plex.tv (Watchlist → "..."
#     → Generate RSS feed; needs Plex Pass). Movies AND shows. The feed carries
#     only the ~50 most-recent additions and the URL is a public secret — keep it
#     in this (gitignored) .env. TMDb ids aren't always present; the poller falls
#     back to a Seerr title+year search when they're missing.
#   - Letterboxd: use a LIST or diary RSS (rich — they include TMDb ids), e.g.
#     https://letterboxd.com/<username>/list/<list-slug>/rss/ (movies). The
#     Letterboxd *watchlist* itself has no usable RSS, so keep a public list of
#     what you want — or use your diary feed https://letterboxd.com/<user>/rss/.
# `owner` is the WhatsApp number the synced request is attributed to (via !map /
# SEERR_DEFAULT_USER_ID) and DM'd when the item is ready. `label` is cosmetic.
# JSON array, one object per feed. Example (single line):
# WATCHLIST_SOURCES=[{"type":"plex","url":"https://rss.plex.tv/<id>","owner":"15555550100","label":"Plex"},{"type":"letterboxd","url":"https://letterboxd.com/<username>/list/<list-slug>/rss/","owner":"15555550100","label":"Letterboxd"}]
WATCHLIST_SOURCES=
# How often to poll each feed (minutes). 0 disables the poller.
WATCHLIST_POLL_MINUTES=15
# Max NEW requests created per poll (already-available / already-seen items don't
# count). Bounds load on Sonarr/Radarr + skyhook; the rest trickle in next poll.
WATCHLIST_MAX_PER_RUN=10

# ---- Plex-Pass-FREE watchlist path (optional) ----
# Lets members WITHOUT Plex Pass have their Plex Watchlist auto-requested: with
# ONE owner token, the poller reads the owner's own + friends' watchlists via
# Plex's free Discover/Community APIs (no RSS to generate). Empty PLEX_TOKEN
# disables it entirely.
#   The FRIEND hands over NOTHING — they just (1) become a mutual Plex friend of
#   the owner and (2) set their Watchlist visibility to "Friends Only" (not
#   Private). Then an admin maps them below, or they self-register with
#   `!watchlist add plex-friend <their-plex-username>` in the group.
# PLEX_TOKEN is the server owner's X-Plex-Token — an ACCOUNT-level secret. Get it
# from app.plex.tv: open any item → ... → Get Info → View XML → copy the
# X-Plex-Token=... value from the URL. Keep it in this (gitignored) .env only.
PLEX_TOKEN=
PLEX_CLIENT_IDENTIFIER=whatsarr
# Override only if Plex changes its API hosts:
PLEX_DISCOVER_HOST=https://discover.provider.plex.tv
PLEX_COMMUNITY_HOST=https://community.plex.tv
# Optional admin-managed friend→WhatsApp map (members can also self-register via
# !watchlist add plex-friend). JSON array; identify the friend by plexUsername
# (and/or plexUserId), and `owner` is the WhatsApp number their requests + ready
# DMs attribute to. Example (single line):
# PLEX_FRIEND_MAP=[{"plexUsername":"alice","owner":"15555550101","label":"Alice"}]
PLEX_FRIEND_MAP=

# ---- Logging ----
LOG_LEVEL=info
